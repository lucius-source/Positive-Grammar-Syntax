{
  "name": "positive-grammar-syntax",
  "version": "0.1.0",
  "private": true,
  "description": "Positive Grammar Syntax core language analysis and transformation engine",
  "type": "module",
  "main": "./dist/public.js",
  "types": "./dist/public.d.ts",
  "exports": {
    ".": {
      "types": "./dist/public.d.ts",
      "import": "./dist/public.js",
      "default": "./dist/public.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "pgs": "node --import tsx src/cli.ts",
    "eval:local": "node --import tsx src/eval-cli.ts",
    "eval:local:preflight": "node scripts/check-local-model.mjs",
    "eval:fidelity": "node --import tsx src/fidelity-eval-cli.ts",
    "eval:fuzz": "node --import tsx src/fidelity-fuzz-cli.ts",
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json && node scripts/finalize-esm-build.mjs",
    "verify:package": "tsc -p tsconfig.package-consumer.json && node scripts/verify-package.mjs",
    "artifacts:ci": "node scripts/write-ci-artifacts.mjs",
    "release:check": "npm run check && npm run artifacts:ci && node scripts/verify-release-candidate.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test && npm run build && npm run verify:package"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
